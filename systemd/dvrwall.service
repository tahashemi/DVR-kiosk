[Unit]
Description=DVR Wall Hardware Compositor
After=network.target local-fs.target go2rtc.service
Wants=go2rtc.service

[Service]
Type=simple
ExecStart=/usr/local/bin/dvrwall --fps 12
Restart=always
RestartSec=3
StandardOutput=append:/var/log/dvrwall.log
StandardError=append:/var/log/dvrwall.log

[Install]
WantedBy=multi-user.target
